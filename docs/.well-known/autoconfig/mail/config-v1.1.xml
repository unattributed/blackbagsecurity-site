<?xml version="1.0" encoding="UTF-8"?>
<clientConfig version="1.1">
  <emailProvider id="blackbagsecurity.com">
    <domain>blackbagsecurity.com</domain>

    <displayName>Black Bag Security Mail</displayName>
    <displayShortName>Black Bag Security</displayShortName>

    <incomingServer type="imap">
      <hostname>mail.blackbagsecurity.com</hostname>
      <port>993</port>
      <socketType>SSL</socketType>
      <username>%EMAILADDRESS%</username>
      <authentication>password-cleartext</authentication>
    </incomingServer>

    <outgoingServer type="smtp">
      <hostname>mail.blackbagsecurity.com</hostname>
      <port>587</port>
      <socketType>STARTTLS</socketType>
      <username>%EMAILADDRESS%</username>
      <authentication>password-cleartext</authentication>
    </outgoingServer>

    <documentation url="https://mail.blackbagsecurity.com/mail/">
      <descr>Webmail and account access</descr>
    </documentation>
  </emailProvider>
</clientConfig>
